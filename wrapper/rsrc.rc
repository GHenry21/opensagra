#include <winuser.h>
#include <winver.h>

/* Risorse dell'eseguibile. Rigenera il .syso con:
 *   windres -F pe-x86-64 -O coff rsrc.rc rsrc_windows_amd64.syso
 * `go build` include automaticamente qualsiasi *.syso nella cartella.
 */

/* Icona dell'exe (Explorer / taskbar / Alt-Tab / proprieta'). La shell usa
 * quella con l'ID numerico piu' basso. Stessa .ico multi-size della tray. */
1 ICON "assets/opensagra.ico"

/* Manifest: Common-Controls v6 (TaskDialog) + DPI awareness. */
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "opensagra.manifest"

/* Info versione (proprieta' file -> Dettagli). */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS         VOS__WINDOWS32
 FILETYPE       VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "OpenSagra"
      VALUE "FileDescription",  "OpenSagra - pannello di controllo"
      VALUE "FileVersion",      "0.1.0"
      VALUE "InternalName",     "opensagra-wrapper"
      VALUE "OriginalFilename", "opensagra-wrapper.exe"
      VALUE "ProductName",      "OpenSagra"
      VALUE "ProductVersion",   "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

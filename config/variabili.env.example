# IP del database: usa 127.0.0.1 per installazione locale oppure l'IP del server di cassa (in caso di database centralizzato)
DB_POS_HOST=127.0.0.1

# Credenziali di accesso al database MySQL/MariaDB
DB_POS_USER=utente
DB_POS_PASS=password

# Segreto condiviso con l'hub Mercure nel Caddyfile (direttive publisher_jwt/
# subscriber_jwt) - opzionale, serve solo se l'hub Mercure e' abilitato
# (Fase 4, realtime). Stringa casuale lunga, es. generata con:
#   openssl rand -base64 48
MERCURE_JWT_SECRET=

# Segreto dell'hub Mercure del SERVER (solo in modalita' rete). NON impostare
# a mano: lo scrive la pagina "Rete" leggendolo dal DB del server al passaggio
# a client. L'hub LOCALE di questo PC continua a usare MERCURE_JWT_SECRET qui
# sopra; questo serve solo per firmare i token diretti all'hub del server.
MERCURE_JWT_SECRET_REMOTE=

# Ponte di stampa nativo (bin/opensagra-print-bridge.php): ACCESO DI DEFAULT -
# questo PC resta sempre in ascolto sul proprio hub Mercure locale, pronto a
# stampare per qualunque cassa che lo scelga come ponte (discovery IP in
# Configura Casse), nessuna configurazione richiesta. Solo "0" lo spegne:
# vuoto conta come acceso (compatibilita' con installazioni precedenti al
# 2026-10-16, che scrivevano qui una riga vuota o un vecchio id-topic - il
# valore in se' non conta piu', solo se e' "0" o no). Costa solo una
# connessione SSE inattiva sui PC senza stampante. Si spegne dalla pagina
# "Rete" (checkbox "Ponte di stampa") se proprio non lo si vuole.
PRINT_BRIDGE_CASSE=1

# Fallback locale una-via (Fase 4). NON impostare a mano: lo scrive
# api/enter_local_fallback.php quando il server centrale resta irraggiungibile
# a lungo, salvando qui il vecchio DB_POS_HOST e spostando DB_POS_HOST su
# 127.0.0.1. La cassa lavora sul DB locale fino a "Chiudi Cassa", che spinge le
# vendite al centrale (api/push_local_sales.php) e riazzera questa riga. Vuoto =
# esercizio normale.
FALLBACK_ORIGIN_HOST=

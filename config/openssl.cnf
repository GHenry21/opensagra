# Config OpenSSL minimale, bundlato con l'app e usato SOLO da
# config/genera_certificati_qz.php per generare la coppia chiave/certificato
# di firma verso QZ Tray.
#
# Bug reale trovato testando su VM pulita (2026-09-07): le funzioni
# openssl_pkey_new()/openssl_csr_new()/openssl_csr_sign() di PHP, su Windows,
# cercano un openssl.cnf di sistema che su una macchina pulita non esiste
# affatto (fallisce con "system library::No such process") - e anche quando
# esiste (es. lasciato da un altro programma), con OpenSSL 3.x puo' avere
# sezioni incompatibili e fallire diversamente ("X509 V3 routines::unknown
# option"). La soluzione affidabile e' non dipendere da NESSUN default di
# sistema: passare sempre questo file esplicitamente (opzione 'config' delle
# funzioni openssl_* citate sopra).
#
# Il blocco [openssl_init]/[provider_sect] e' necessario per OpenSSL 3.x
# (FrankenPHP usa OpenSSL 3.5.7): senza, il provider "default" non viene
# caricato e le operazioni di base (anche solo generare una chiave RSA)
# falliscono con un errore generico e fuorviante ("no protocol option").
openssl_conf = openssl_init

[openssl_init]
providers = provider_sect

[provider_sect]
default = default_sect

[default_sect]
activate = 1

[req]
distinguished_name = req_distinguished_name
x509_extensions = v3_ca

[req_distinguished_name]

[v3_ca]
basicConstraints = CA:false

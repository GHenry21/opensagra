# Cartella delle dipendenze di Composer (verrà rigenerata via script)
/vendor/

# Dipendenze npm (Playwright) e output dei test e2e, rigenerati via `npm install`
/node_modules/
/test-results/
/playwright-report/

# File di test temporanei o log
*.log
*.tmp

# File di sistema e ide
.DS_Store
Thumbs.db
.vscode/
.idea/

# File di configurazione locale con eventuali password (se usi file .env)
.env

# Credenziali reali del DB per questa installazione (generato dal wizard di
# Fase 3, o copiato a mano da variabili.env.example). Resta solo in locale.
/config/variabili.env
# cartelle/che di lavoro
/.liveui.json

# CA locale generata da FrankenPHP/Caddy (specifica alla macchina, rigenerata
# ad ogni installazione dallo script di Fase 3)
/cert/caddy-root-ca.crt

# Caddyfile reale di questa macchina/installazione (path assoluti locali, e
# dal 2026-09-07 puo' contenere il segreto JWT di Mercure in chiaro). Resta
# solo in locale, come variabili.env - tracciato solo Caddyfile.example.
/Caddyfile

